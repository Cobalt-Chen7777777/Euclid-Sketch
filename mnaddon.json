{
  "addonid": "com.mathsketch.addon",
  "author": "MathSketch",
  "title": "Euclid Sketch",
  "version": "0.3.0-beta.2",
  "marginnote_version_min": "4.5.0",
  "immersiveOnly": true,
  "panel": "index.html",
  "icon": "icon.png",
  "panelWidth": 420,
  "panelMaxHeight": 900,
  "events": [
    "excerpt"
  ],
  "cardCommands": [
    {
      "id": "annotate",
      "title": {
        "zh-Hans": "写入批注",
        "en": "Add a comment"
      },
      "when": {
        "hasExcerpt": true
      }
    },
    {
      "id": "import-image",
      "title": {
        "zh-Hans": "导入此卡到草图",
        "en": "Import to sketch"
      },
      "when": {
        "hasExcerpt": true
      }
    },
    {
      "id": "set-target",
      "title": {
        "zh-Hans": "设为草图目标卡",
        "en": "Set as sketch target"
      }
    }
  ]
}
